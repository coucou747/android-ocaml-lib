<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <activity android:name="org.ocaml.android.BridgeActivity" android:exported="false" />
    <activity android:name="org.ocaml.android.PhotoCaptureActivity" android:exported="false" android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    <activity android:name="org.ocaml.android.AlarmScreenActivity" android:exported="false" android:launchMode="singleTop" android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    <provider android:name="org.ocaml.android.PhotoProvider" android:authorities="${applicationId}.ocaml.photos" android:exported="false" android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/ocaml_photo_paths" />
    </provider>
    <receiver android:name="org.ocaml.android.BridgeReceiver" android:exported="false" />
    <service android:name="org.ocaml.android.BridgeJobService" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
    <service android:name="org.ocaml.android.BridgeService" android:exported="false" />
  </application>
</manifest>
